{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://droidquest.dev/schema/quiz.schema.json",
  "title": "DroidQuest quiz",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "categoryId", "linkedLessonIds", "kind", "difficulty", "passingScore", "questions", "rewards", "version"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 5 },
    "categoryId": { "type": "string", "minLength": 3 },
    "linkedLessonIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "kind": { "enum": ["lesson", "week_checkpoint", "level_checkpoint", "boss"] },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced", "expert"] },
    "passingScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "questions": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "prompt", "type", "difficulty", "answer", "explanation", "lessonId"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "prompt": { "type": "string", "minLength": 12 },
          "type": { "enum": ["single_choice", "multiple_choice", "true_false", "fill_blank", "order_steps", "match_pairs", "code_output", "spot_bug", "short_answer"] },
          "difficulty": { "enum": ["beginner", "intermediate", "advanced", "expert"] },
          "options": { "type": "array", "minItems": 2, "items": {} },
          "answer": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "array" }, { "type": "object" }] },
          "acceptedAnswers": { "type": "array", "items": { "type": "string" } },
          "explanation": { "type": "string", "minLength": 25 },
          "lessonId": { "type": "string", "minLength": 3 }
        }
      }
    },
    "rewards": { "type": "object", "additionalProperties": false, "required": ["xp", "stars"], "properties": { "xp": { "type": "integer", "minimum": 1 }, "stars": { "type": "integer", "minimum": 1, "maximum": 5 } } },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
  }
}
