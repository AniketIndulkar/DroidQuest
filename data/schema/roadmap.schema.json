{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://droidquest.dev/schema/roadmap.schema.json",
  "title": "DroidQuest roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "version", "nodes", "edges"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 5 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "categoryId", "title", "type", "status", "difficulty", "estimatedLearningMinutes", "unlockPrerequisites", "rewards"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "categoryId": { "type": "string" },
          "title": { "type": "string", "minLength": 3 },
          "type": { "enum": ["start", "lesson", "checkpoint", "boss", "level_preview"] },
          "status": { "enum": ["available", "planned"] },
          "lessonId": { "type": "string" },
          "quizId": { "type": "string" },
          "difficulty": { "enum": ["beginner", "intermediate", "advanced", "expert"] },
          "estimatedLearningMinutes": { "type": "integer", "minimum": 0, "maximum": 10 },
          "unlockPrerequisites": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "rewards": { "type": "object", "additionalProperties": false, "required": ["xp", "stars"], "properties": { "xp": { "type": "integer", "minimum": 0 }, "stars": { "type": "integer", "minimum": 0, "maximum": 5 } } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["from", "to", "kind"], "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "kind": { "enum": ["prerequisite", "level_unlock", "planned_sequence"] } } }
    }
  }
}
